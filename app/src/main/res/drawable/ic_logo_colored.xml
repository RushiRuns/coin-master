<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Premium Rounded Square (Squircle) Background -->
    <path
        android:pathData="M26,6 h56 a20,20 0 0 1 20,20 v56 a20,20 0 0 1 -20,20 h-56 a20,20 0 0 1 -20,-20 v-56 a20,20 0 0 1 20,-20 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="6"
                android:startY="6"
                android:endX="102"
                android:endY="102"
                android:type="linear">
                <item android:color="#3136E8" android:offset="0.0" />
                <item android:color="#0A0D5C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 1. Background Card Shadow -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-18"
        android:translateX="-7"
        android:translateY="-1">
        <path
            android:fillColor="#25000000"
            android:pathData="M40.5,42 h27 a5.5,5.5 0 0 1 5.5,5.5 v13 a5.5,5.5 0 0 1 -5.5,5.5 h-27 a5.5,5.5 0 0 1 -5.5,-5.5 v-13 a5.5,5.5 0 0 1 5.5,-5.5 z" />
    </group>

    <!-- 2. Background Card (Solid Cyan Gradient) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-18"
        android:translateX="-8"
        android:translateY="-3">
        <path
            android:pathData="M40.5,42 h27 a5.5,5.5 0 0 1 5.5,5.5 v13 a5.5,5.5 0 0 1 -5.5,5.5 h-27 a5.5,5.5 0 0 1 -5.5,-5.5 v-13 a5.5,5.5 0 0 1 5.5,-5.5 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35"
                    android:startY="42"
                    android:endX="73"
                    android:endY="66"
                    android:type="linear">
                    <item android:color="#00D2FF" android:offset="0.0" />
                    <item android:color="#0066FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- 3. Foreground Card Shadow -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-10"
        android:translateX="9"
        android:translateY="8">
        <path
            android:fillColor="#35000000"
            android:pathData="M40.5,42 h27 a5.5,5.5 0 0 1 5.5,5.5 v13 a5.5,5.5 0 0 1 -5.5,5.5 h-27 a5.5,5.5 0 0 1 -5.5,-5.5 v-13 a5.5,5.5 0 0 1 5.5,-5.5 z" />
    </group>

    <!-- 4. Foreground Card (Glassmorphism + Border) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-10"
        android:translateX="8"
        android:translateY="5">
        <path
            android:strokeWidth="1.2"
            android:strokeColor="#D0FFFFFF"
            android:pathData="M40.5,42 h27 a5.5,5.5 0 0 1 5.5,5.5 v13 a5.5,5.5 0 0 1 -5.5,5.5 h-27 a5.5,5.5 0 0 1 -5.5,-5.5 v-13 a5.5,5.5 0 0 1 5.5,-5.5 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35"
                    android:startY="42"
                    android:endX="73"
                    android:endY="66"
                    android:type="linear">
                    <item android:color="#80FFFFFF" android:offset="0.0" />
                    <item android:color="#1AFFFFFF" android:offset="0.5" />
                    <item android:color="#2580C0FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

</vector>
