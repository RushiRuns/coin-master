<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Top App Bar with Lift-on-Scroll -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="@string/title_budget"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content with Layout Behavior -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="88dp">

            <!-- Month Navigation Switcher -->
            <LinearLayout
                android:id="@+id/layout_month_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/spacing_screen_edge"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btn_prev_month"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@string/cd_previous_month"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tv_month_year"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/placeholder_june_2026"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_next_month"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/cd_next_month"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- ZBB Validation Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_budget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="@dimen/shape_large"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:layout_constraintTop_toBottomOf="@id/layout_month_switcher">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_edge">

                    <TextView
                        android:id="@+id/tv_declared_income"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/placeholder_declared_income"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_unallocated_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/placeholder_left_to_budget"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- Simple helper indicator -->
                    <TextView
                        android:id="@+id/tv_status_helper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/text_zbb_rule"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_grouped"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button android:id="@+id/btn_setup_month"
                            style="@style/Widget.Clarity.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_setup_month" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Button style="@style/Widget.Clarity.Button.Primary" 
                            android:id="@+id/btn_activate_budget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_activate_budget"
                             />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Copy Previous Month Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_copy_previous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/spacing_grouped"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/shape_large"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/primary"
                app:cardBackgroundColor="@color/surface"
                app:layout_constraintTop_toBottomOf="@id/card_budget_status"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_list_item">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_budget"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tv_copy_previous_msg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="Copy allocations from the previous month?"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Button android:id="@+id/btn_copy_previous"
                        style="@style/Widget.Clarity.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy"
                        android:textColor="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Needs Bucket Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_needs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/spacing_grouped"
                app:cardCornerRadius="@dimen/shape_large"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:layout_constraintTop_toBottomOf="@id/card_copy_previous">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_edge">

                    <!-- Bucket Header -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_needs_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_needs_percent"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_needs_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₹0 / ₹0"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Linear Progress Indicator -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_needs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp"
                        app:indicatorColor="@color/primary"
        app:trackColor="@color/color_outline_variant" />

                    <!-- Envelopes Container -->
                    <LinearLayout
                        android:id="@+id/container_needs_envelopes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_grouped"
                        android:orientation="vertical" />

                    <!-- Add Category action -->
                    <Button android:id="@+id/btn_add_needs_envelope"
                        style="@style/Widget.Clarity.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_add_needs_envelope"
                        android:textColor="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wants Bucket Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_wants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/spacing_grouped"
                app:cardCornerRadius="@dimen/shape_large"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:layout_constraintTop_toBottomOf="@id/card_needs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_edge">

                    <!-- Bucket Header -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_wants_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_wants_percent"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_wants_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₹0 / ₹0"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Linear Progress Indicator -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_wants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp"
                        app:indicatorColor="@color/secondary"
        app:trackColor="@color/color_outline_variant" />

                    <!-- Envelopes Container -->
                    <LinearLayout
                        android:id="@+id/container_wants_envelopes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_grouped"
                        android:orientation="vertical" />

                    <!-- Add Category action -->
                    <Button android:id="@+id/btn_add_wants_envelope"
                        style="@style/Widget.Clarity.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_add_wants_envelope"
                        android:textColor="@color/secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Savings Bucket Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_savings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="@dimen/spacing_grouped"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/shape_large"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:layout_constraintTop_toBottomOf="@id/card_wants">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_screen_edge">

                    <!-- Bucket Header -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_savings_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_savings_percent"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_savings_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₹0 / ₹0"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- Linear Progress Indicator -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_savings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp"
                        app:indicatorColor="@color/color_wants"
        app:trackColor="@color/color_outline_variant" />

                    <!-- Envelopes Container -->
                    <LinearLayout
                        android:id="@+id/container_savings_envelopes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_grouped"
                        android:orientation="vertical" />

                    <!-- Add Category action -->
                    <Button android:id="@+id/btn_add_savings_envelope"
                        style="@style/Widget.Clarity.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_add_savings_envelope"
                        android:textColor="@color/color_wants" />

                    <Button android:id="@+id/btn_manage_goals"
                        style="@style/Widget.Clarity.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/btn_manage_goals"
                        android:textColor="@color/color_wants" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit"
        app:tint="@color/white"
        android:contentDescription="@string/cd_add_transaction"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Clarity.Large" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
