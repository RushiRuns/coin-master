<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_screen_edge"
    android:background="@color/surface">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_grouped"
        android:background="@color/divider" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Search Envelopes"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Clarity.Title3" />

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputLayout app:boxCornerRadiusBottomEnd="@dimen/shape_medium" app:boxCornerRadiusBottomStart="@dimen/shape_medium" app:boxCornerRadiusTopEnd="@dimen/shape_medium" app:boxCornerRadiusTopStart="@dimen/shape_medium"
        android:id="@+id/til_search"
        app:boxBackgroundMode="filled" app:boxBackgroundColor="@color/color_surface_variant"     app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Type envelope name..."
        app:startIconDrawable="@drawable/ic_search"
        app:endIconMode="clear_text"
        
        
        
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_search_envelope" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No envelopes found."
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Clarity.Callout"
        android:visibility="gone" />

</LinearLayout>
