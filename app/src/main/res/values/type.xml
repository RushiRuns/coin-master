<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base text appearance using Inter -->
    <style name="TextAppearance.Clarity" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Clarity.Display">
        <item name="android:textSize">52sp</item>
        <item name="android:lineHeight">60sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.LargeTitle">
        <item name="android:textSize">34sp</item>
        <item name="android:lineHeight">42sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.Title1">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.Title2">
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.Title3">
        <item name="android:textSize">20sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.Headline">
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.Body">
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">-0.022</item>
    </style>

    <style name="TextAppearance.Clarity.Callout">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">-0.011</item>
    </style>

    <style name="TextAppearance.Clarity.Subheadline">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">-0.011</item>
    </style>

    <style name="TextAppearance.Clarity.Footnote">
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">0.000</item>
    </style>

    <style name="TextAppearance.Clarity.Caption1">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">0.011</item>
    </style>

    <style name="TextAppearance.Clarity.Caption2">
        <item name="android:textSize">11sp</item>
        <item name="android:lineHeight">14sp</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">0.022</item>
    </style>

    <!-- Financial Amount Typography -->
    <style name="TextAppearance.Clarity.AmountHero">
        <item name="android:textSize">52sp</item>
        <item name="android:lineHeight">60sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Clarity.AmountLarge">
        <item name="android:textSize">34sp</item>
        <item name="android:lineHeight">42sp</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Clarity.AmountStandard">
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Clarity.AmountList">
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="fontFamily">@font/jetbrains_mono_medium</item>
    </style>

    <style name="TextAppearance.Clarity.AmountSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="fontFamily">@font/jetbrains_mono_medium</item>
    </style>

    <style name="TextAppearance.Clarity.AmountCaption">
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="fontFamily">@font/jetbrains_mono_regular</item>
    </style>

</resources>
